# Scanner pins shared by experiments/Dockerfile and backend/Dockerfile.worker
# (both run tools/install-scanners.sh). A change here changes scan results: keep the
# profile configs' semgrep_version, codeql_version and query-pack versions in step.
SEMGREP_VERSION=1.178.0
CODEQL_VERSION=2.27.1
CODEQL_BUNDLE_URL=https://github.com/github/codeql-action/releases/download/codeql-bundle-v2.27.1/codeql-bundle-linux64.tar.zst
CODEQL_BUNDLE_SHA256=1ec99cfa9420f04c2330784b4ddb8363a0dd67c3e4471cd93963c50e6c433717
CODEQL_JAVASCRIPT_QUERY_PACK=2.4.6
CODEQL_PYTHON_QUERY_PACK=1.8.11
