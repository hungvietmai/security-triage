{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hungvietmai/security-triage/blob/main/experiments/schemas/pair-manifest.schema.json",
  "title": "Security Triage Vulnerability Pair Manifest",
  "description": "Inventory/evaluation manifest for vulnerable/fixed pairs under Amendments 02–03. It records provenance and source acquisition; it does not authorize a scan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "group_id",
    "dataset",
    "repository",
    "vulnerability_id",
    "language",
    "dataset_reported_category",
    "reported_cwes",
    "adjudicated_cwe",
    "cwe_provenance",
    "vulnerable_ref",
    "fix_commit",
    "fixed_ref",
    "reference_provenance",
    "split",
    "exclusion_reason",
    "vulnerable_source",
    "fixed_source"
  ],
  "properties": {
    "sink_hint": {
      "type": "string",
      "pattern": "^[^:]+:[1-9][0-9]*:[1-9][0-9]*$",
      "description": "Published SecBench sink coordinate, retained verbatim; not a resolved label."
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "enum": ["SecBench.js", "PyVul"]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "vulnerability_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": ["javascript", "python"]
    },
    "dataset_reported_category": {
      "type": "string",
      "minLength": 1
    },
    "reported_cwes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      }
    },
    "adjudicated_cwe": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^CWE-[0-9]+$"
        },
        {
          "const": "cwe_unresolved"
        }
      ]
    },
    "cwe_provenance": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vulnerable_ref": {
      "type": ["string", "null"]
    },
    "fix_commit": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fixed_ref": {
      "type": ["string", "null"]
    },
    "reference_provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split": {
      "type": "string",
      "enum": ["unassigned", "development", "held_out", "reserve", "excluded"]
    },
    "exclusion_reason": {
      "type": ["string", "null"]
    },
    "vulnerable_source": {
      "$ref": "#/$defs/source_or_null"
    },
    "fixed_source": {
      "$ref": "#/$defs/source_or_null"
    },
    "scope_verdict": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["in_scope", "out_of_scope", "unresolved"]
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ]
    },
    "scope_reason": {
      "type": "string"
    },
    "sink_kind": {
      "type": "string"
    },
    "os_command_execution_basis": {
      "type": "string"
    },
    "scope_review_provenance": {
      "type": "string"
    },
    "prior_exposure": {
      "type": "boolean",
      "description": "True only when this vulnerability group was exposed before the frozen split and must remain development."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exclusion_reason": {
            "type": "null"
          }
        },
        "required": ["exclusion_reason"]
      },
      "then": {
        "properties": {
          "vulnerable_ref": {
            "type": "string",
            "minLength": 1
          },
          "fixed_ref": {
            "type": "string",
            "minLength": 1
          },
          "vulnerable_source": {
            "$ref": "#/$defs/source"
          },
          "fixed_source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  ],
  "$defs": {
    "npm_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "package_name",
        "package_version",
        "source_reference"
      ],
      "properties": {
        "source_kind": {
          "const": "npm_tarball"
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "artifact_url": {
          "type": "string",
          "format": "uri"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_integrity": {
          "type": "string",
          "minLength": 1
        },
        "archive_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "repository", "commit", "source_reference"],
      "properties": {
        "source_kind": {
          "const": "github_tarball"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "artifact_url": {
          "type": "string",
          "format": "uri"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archive_root": {
          "type": "string",
          "minLength": 1
        },
        "identity_files_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/npm_source"
        },
        {
          "$ref": "#/$defs/github_source"
        }
      ]
    },
    "source_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
