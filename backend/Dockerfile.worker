# syntax=docker/dockerfile:1
# Scan worker: the backend runtime plus the pinned Semgrep/CodeQL and the scan profile.
# Build context is the repository root (tools/, profiles/ and pinned experiments/ files);
# the API keeps the light backend/Dockerfile image.
FROM python:3.12-slim-bookworm AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

FROM python:3.12-slim-bookworm AS runtime
# Semgrep lands in the system Python, separate from the app's /opt/venv.
COPY tools /srv/triage/tools
RUN sh /srv/triage/tools/install-scanners.sh
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:/opt/codeql:$PATH" \
    SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0 \
    TRIAGE_ROOT=/srv/triage
RUN useradd --create-home --uid 10001 appuser
COPY --from=dependencies /opt/venv /opt/venv
# Profile files keep their repository paths; profile.json pins each one by hash.
COPY profiles /srv/triage/profiles
COPY experiments/configs /srv/triage/experiments/configs
COPY experiments/rules /srv/triage/experiments/rules
COPY experiments/mappings /srv/triage/experiments/mappings
COPY experiments/policy /srv/triage/experiments/policy
COPY experiments/locators /srv/triage/experiments/locators
WORKDIR /app
COPY --chown=appuser:appuser backend/ .
USER appuser
CMD ["sh", "-c", "python -m scripts.check_worker && exec celery -A app.workers.celery_app:celery_app worker --loglevel=INFO"]
